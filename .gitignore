# ============================================================
# BACKEND - Django / Python
# ============================================================

# Variables d'environnement locales et secrets
backend/.env
backend/.env.*

# Exemple de configuration à versionner
!backend/.env.example

# Environnement virtuel Python
backend/.venv/
backend/venv/

# Fichiers Python générés
**/__pycache__/
*.py[cod]
*$py.class

# Django
backend/db.sqlite3
backend/staticfiles/
backend/media/

# Tests / coverage
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/


# ============================================================
# FRONTEND - JavaScript / TypeScript
# ============================================================

# Dépendances Node
frontend/node_modules/

# Builds
frontend/dist/
frontend/build/

# Variables d'environnement frontend
frontend/.env
frontend/.env.*
!frontend/.env.example

# Tests / coverage frontend
frontend/coverage/

# Cache des outils frontend
frontend/.cache/


# ============================================================
# IDE / OS
